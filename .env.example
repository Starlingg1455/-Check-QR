# Sao chép thành .env rồi sửa. Khi deploy, đặt các biến này trong dashboard của từng service.

# Chuỗi kết nối PostgreSQL (Supabase). Để trống => dùng DB cục bộ PGlite trong thư mục .data
DATABASE_URL=

# Khoá ký JWT - PHẢI giống nhau ở cả 4 service
JWT_SECRET=doi-chuoi-nay-khi-deploy
# Khoá ký mã QR (chỉ session-qr dùng)
QR_SECRET=doi-chuoi-qr-khi-deploy

# Đăng nhập Google (để trống => chỉ có đăng nhập thử nghiệm)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Email giảng viên, cách nhau dấu phẩy. Email khác sẽ là sinh viên.
TEACHER_EMAILS=
# Cho phép đăng nhập thử nghiệm (không cần Google). Tắt khi chạy thật: false
ALLOW_DEV_LOGIN=true

# Địa chỉ các service (gateway dùng để chuyển tiếp, các service dùng để gọi nhau)
ACCOUNT_URL=http://localhost:4001
SESSION_URL=http://localhost:4002
ATTENDANCE_URL=http://localhost:4003
STATISTICS_URL=http://localhost:4004

# Gửi email cảnh báo (để trống => chỉ ghi log, không gửi thật)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Điểm danh QR <no-reply@example.com>"

# Sau bao nhiêu phút kể từ lúc mở buổi thì quét QR bị tính là "đi trễ"
LATE_MINUTES=15
# Domain frontend được phép gọi gateway (để trống = cho phép tất cả)
CORS_ORIGIN=
